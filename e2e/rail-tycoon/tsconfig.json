{
  // The browser harness and its stories run under bun, outside the Nuxt app; bun run typecheck
  // does not see e2e/, so check them with: bunx tsc --noEmit -p e2e/rail-tycoon/tsconfig.json
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true
  },
  "include": ["./*.ts"]
}
